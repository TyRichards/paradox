---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import PlaceholderNote from './PlaceholderNote.astro';
import { getPage } from '../lib/content';

interface Props {
  id: string;
}

const page = await getPage(Astro.props.id);
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader title={page.data.title} />
  <div class="mx-auto max-w-6xl px-6">
    {page.data.placeholder && <PlaceholderNote />}
    <div class="prose prose-lg max-w-3xl">
      <Content />
    </div>
    <slot />
  </div>
</BaseLayout>
