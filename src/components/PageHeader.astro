---
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
}

const { title, eyebrow, lede } = Astro.props;
---

<header class="mx-auto max-w-6xl px-6 pt-16 pb-10 sm:pt-24">
  {eyebrow && <p class="mb-3 text-sm font-bold tracking-widest text-accent uppercase">{eyebrow}</p>}
  <h1 class="text-4xl font-black tracking-tight text-balance sm:text-5xl">{title}</h1>
  {lede && <p class="mt-4 max-w-2xl text-lg text-muted">{lede}</p>}
  <slot />
</header>
