---
import { Button } from '@/components/starwind/button';
import { Separator } from '@/components/starwind/separator';
import { hasPosts } from '@/lib/content';
import { site } from '@/lib/site';
import { ui } from '@/lib/ui';

const year = new Date().getFullYear();
const showRss = await hasPosts();
---

<footer class="mt-24 bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-2xl font-black tracking-tight">{ui.footer.heading}</p>
        <p class="mt-1 text-paper/70">{ui.footer.text}</p>
      </div>
      <Button href={ui.footer.cta.href} class="shrink-0 bg-teal-light text-ink hover:bg-paper">{ui.footer.cta.label}</Button>
    </div>
    <Separator class="my-8 bg-paper/15" />
    <div class="flex flex-col gap-4 text-sm text-paper/70 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. {ui.footer.tagline}</p>
      <ul class="flex flex-wrap gap-6">
        {
          ui.footer.links.map((link) => (
            <li>
              <a class="hover:text-teal-light" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
        {
          showRss && (
            <li>
              <a class="hover:text-teal-light" href="/rss.xml">
                {ui.footer.rssLabel}
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</footer>
