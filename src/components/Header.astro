---
import Menu from '@tabler/icons/outline/menu-2.svg';
import { Button } from '@/components/starwind/button';
import { Sheet, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from '@/components/starwind/sheet';
import { site } from '@/lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b bg-background/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="block shrink-0 rounded-sm">
      <img
        src="/logo.png"
        alt={site.name}
        width="511"
        height="97"
        class="block h-8 w-auto max-w-full object-contain object-left"
      />
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((item) => (
            <li>
              <Button
                href={item.href}
                variant="ghost"
                size="sm"
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="font-semibold tracking-wide uppercase aria-[current=page]:bg-muted aria-[current=page]:text-primary"
              >
                {item.label}
              </Button>
            </li>
          ))
        }
      </ul>
    </nav>

    <Sheet class="md:hidden">
      <SheetTrigger asChild>
        <Button variant="ghost" size="icon" aria-label="Open menu">
          <Menu />
        </Button>
      </SheetTrigger>
      <SheetContent side="right" class="p-6">
        <SheetHeader class="p-0">
          <SheetTitle>Menu</SheetTitle>
        </SheetHeader>
        <nav aria-label="Mobile">
          <ul class="flex flex-col gap-1">
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class="block rounded-md px-3 py-2 text-lg font-semibold hover:bg-muted aria-[current=page]:text-primary"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </SheetContent>
    </Sheet>
  </div>
</header>
