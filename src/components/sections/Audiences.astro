---
import { Card, CardDescription, CardHeader, CardTitle } from '@/components/starwind/card';

interface Props {
  heading: string;
  items: { title: string; body: string }[];
}

const { heading, items } = Astro.props;
---

<div>
  <h2 class="mb-8 font-heading text-3xl font-black tracking-tight">{heading}</h2>
  <ul class="grid gap-6 md:grid-cols-2">
    {
      items.map((item) => (
        <li class="h-full">
          <Card class="h-full border-l-4 border-teal-light">
            <CardHeader>
              <CardTitle class="font-bold">{item.title}</CardTitle>
              <CardDescription>{item.body}</CardDescription>
            </CardHeader>
          </Card>
        </li>
      ))
    }
  </ul>
</div>
