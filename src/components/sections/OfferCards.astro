---
import type { CollectionEntry } from 'astro:content';
import Check from '@tabler/icons/outline/check.svg';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/starwind/card';
import { offerContactHref } from '@/lib/content';
import { ui } from '@/lib/ui';

interface Props {
  offers: CollectionEntry<'offers'>[];
}

const { offers } = Astro.props;
---

<ul class="grid items-stretch gap-6 lg:grid-cols-3">
  {
    offers.map((offer) => {
      const { title, price, cadence, summary, bullets, ctaLabel, featured, featuredLabel } = offer.data;
      return (
        <li class="h-full" id={offer.id}>
          <Card
            class:list={[
              'h-full',
              featured ? 'bg-ink text-paper shadow-xl ring-2 ring-teal-light' : 'border-t-4 border-teal-light',
            ]}
          >
            <CardHeader>
              {featured && (
                <Badge eyebrow size="sm" class="mb-2 w-fit bg-teal-light font-bold text-ink">
                  {featuredLabel ?? ui.pricing.featuredDefaultLabel}
                </Badge>
              )}
              <CardTitle class="text-xl font-bold">{title}</CardTitle>
              <p class="mt-2 flex items-baseline gap-2">
                <span class="font-heading text-4xl font-black tracking-tight">{price}</span>
                {cadence && <span class:list={['text-sm', featured ? 'text-paper/70' : 'text-muted-foreground']}>{cadence}</span>}
              </p>
              <CardDescription class:list={['mt-2', featured && 'text-paper/80']}>{summary}</CardDescription>
            </CardHeader>
            <CardContent class="flex-1">
              <ul class="space-y-3 text-sm">
                {bullets.map((b) => (
                  <li class="flex gap-2">
                    <Check class:list={['mt-0.5 size-4 shrink-0', featured ? 'text-teal-light' : 'text-primary']} aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </CardContent>
            <CardFooter class="border-t-0 bg-transparent">
              <Button
                href={offerContactHref(offer.id)}
                size="lg"
                variant={featured ? undefined : 'primary'}
                class:list={['w-full rounded-full font-bold', featured && 'bg-teal-light text-ink hover:bg-paper']}
              >
                {ctaLabel}
              </Button>
            </CardFooter>
          </Card>
        </li>
      );
    })
  }
</ul>
