---
import { Avatar, AvatarImage } from '@/components/starwind/avatar';
import { Button } from '@/components/starwind/button';

interface Props {
  heading: string;
  eyebrow?: string;
  lede?: string;
  ctas?: { label: string; href: string }[];
  portrait?: { src: string; alt: string };
}

const { heading, eyebrow, lede, ctas = [], portrait } = Astro.props;
---

<section class="bg-ink text-paper">
  <div class="mx-auto flex max-w-6xl flex-col items-center px-6 py-20 text-center sm:py-28">
    {
      portrait && (
        <Avatar class="mb-10 h-40 w-40 border-4 border-teal-light bg-paper sm:h-52 sm:w-52">
          <AvatarImage src={portrait.src} alt={portrait.alt} width="600" height="600" fetchpriority="high" />
        </Avatar>
      )
    }
    {eyebrow && <p class="mb-4 text-sm font-bold tracking-widest text-teal-light uppercase">{eyebrow}</p>}
    <h1 class="max-w-4xl font-heading text-4xl leading-tight font-black tracking-tight text-balance sm:text-6xl">
      {heading}
    </h1>
    {lede && <p class="mt-6 max-w-2xl text-lg text-pretty text-paper/80 sm:text-xl">{lede}</p>}
    {
      ctas.length > 0 && (
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          {ctas.map((cta, i) => (
            <Button
              href={cta.href}
              size="lg"
              class:list={[
                'rounded-full font-bold',
                i === 0
                  ? 'bg-teal-light text-ink hover:bg-paper'
                  : 'border border-paper/40 bg-transparent text-paper hover:bg-paper hover:text-ink',
              ]}
            >
              {cta.label}
            </Button>
          ))}
        </div>
      )
    }
  </div>
</section>
