---
import { Alert, AlertDescription } from '@/components/starwind/alert';

interface Props {
  label?: string;
}

const { label = 'Placeholder content — replace before launch.' } = Astro.props;
---

<Alert variant="warning" role="note" class="my-6 border-dashed bg-warning/40 text-warning-foreground">
  <AlertDescription class="text-sm font-semibold">{label}</AlertDescription>
</Alert>
