---
import Button from "@/components/Button.astro";
import Input from "@/components/form/Input.astro";
import Select from "@/components/form/Select.astro";
import Textarea from "@/components/form/Textarea.astro";
import { getOffers } from "@/lib/content";
import { ui } from "@/lib/ui";

interface Props {
  render?: boolean;
  siteKey?: string;
  class?: string;
}

const { render = true, siteKey = "", class: className } = Astro.props;
const configured = Boolean(siteKey);

const t = ui.contact;
const offers = await getOffers();
const messages = {
  submit: t.submitLabel,
  sending: t.sendingLabel,
  tokenPending: t.tokenPending,
  errors: t.errors,
};
---

{render && (
  <form
    id="contact-form"
    action="/api/contact"
    method="post"
    class:list={["contact-form_wrap", className]}
    novalidate
    data-configured={configured ? "true" : "false"}
    data-messages={JSON.stringify(messages)}
  >
    {!configured && (
      <div class="contact-form_note warning" role="status">
        <p class="contact-form_note-title">{t.notConfiguredTitle}</p>
        <p>{t.notConfiguredText}</p>
      </div>
    )}

    <fieldset class="contact-form_fields" disabled={!configured}>
        <Input label={t.nameLabel} name="name" placeholder="" autocomplete="name" required maxlength={200} />
        <Input label={t.emailLabel} variant="email" name="email" placeholder="" required maxlength={320} />
        <Input label={t.companyLabel} name="company" placeholder="" autocomplete="organization" maxlength={200} />
        <Select
          label={t.offerLabel}
          name="offer"
          id="contact-offer"
          placeholder={t.offerOther}
          options={offers.map((offer) => ({ value: offer.id, label: `${offer.data.title} (${offer.data.price})` }))}
        />
      <Textarea label={t.messageLabel} name="message" minLines={6} required maxlength={5000} placeholder={t.messagePlaceholder} />

      <div class="contact-form_trap" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {configured && <div class="cf-turnstile" data-sitekey={siteKey} data-action="contact" data-theme="light" />}

      <div>
        <Button type="submit" data-submit>{t.submitLabel}</Button>
      </div>
    </fieldset>

    <div data-status aria-live="polite"></div>
  </form>
)}

<template id="contact-success">
  <div class="contact-form_note success">
    <p class="contact-form_note-title">{t.successTitle}</p>
    <p>{t.successText}</p>
  </div>
</template>
<template id="contact-error">
  <div class="contact-form_note error">
    <p class="contact-form_note-title">{t.errorTitle}</p>
    <p data-message>{t.errorText}</p>
  </div>
</template>

<script>
  declare global {
    interface Window {
      turnstile?: { reset: (widget?: string | HTMLElement) => void };
    }
  }

  type Messages = { submit: string; sending: string; tokenPending: string; errors: Record<string, string> };

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const messages: Messages = JSON.parse(form?.dataset.messages ?? "{}");
  const params = new URLSearchParams(location.search);

  const offerSelect = form?.querySelector<HTMLSelectElement>("#contact-offer");
  const requestedOffer = params.get("offer");
  if (offerSelect && requestedOffer && [...offerSelect.options].some((o) => o.value === requestedOffer)) {
    offerSelect.value = requestedOffer;
  }

  function showStatus(kind: "success" | "error", message?: string) {
    const target = form?.querySelector<HTMLElement>("[data-status]");
    const template = document.querySelector<HTMLTemplateElement>(`#contact-${kind}`);
    if (!target || !template) return;
    const node = template.content.cloneNode(true) as DocumentFragment;
    const text = node.querySelector<HTMLElement>("[data-message]");
    if (message && text) text.textContent = message;
    target.replaceChildren(node);
  }

  const errorMessage = (code?: string | null) => (code ? messages.errors?.[code] : undefined);

  function setBusy(busy: boolean) {
    const button = form?.querySelector<HTMLButtonElement>("[data-submit]");
    if (!button) return;
    button.disabled = busy;
    button.setAttribute("aria-busy", String(busy));
    const label = button.querySelector(".button_text") ?? button;
    label.textContent = busy ? messages.sending : messages.submit;
  }

  const status = params.get("status");
  if (status === "sent") showStatus("success");
  if (status === "error") showStatus("error", errorMessage(params.get("code")));

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (form.dataset.configured !== "true") return;
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (!data.get("cf-turnstile-response")) {
      showStatus("error", messages.tokenPending);
      return;
    }

    setBusy(true);
    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new URLSearchParams(data as unknown as Record<string, string>),
      });
      const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (res.ok && body.ok) {
        const offer = offerSelect?.value;
        form.reset();
        if (offerSelect && offer) offerSelect.value = offer;
        showStatus("success");
      } else {
        showStatus("error", errorMessage(body.error));
      }
    } catch {
      showStatus("error");
    } finally {
      setBusy(false);
      window.turnstile?.reset();
    }
  });
</script>

<style is:global>
  @layer components {
    .contact-form_wrap {
      width: 100%;
      max-width: 36rem;
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }
    .contact-form_fields {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      border: 0;
      padding: 0;
      margin: 0;
      min-width: 0;
      &:disabled {
        opacity: 0.6;
      }
    }
    .contact-form_trap {
      position: absolute;
      left: -9999rem;
      width: 0.0625rem;
      height: 0.0625rem;
      overflow: hidden;
    }
    .contact-form_note {
      --_accent: var(--heading-accent);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-5);
      border-radius: var(--radius-small);
      border-left: 0.25rem solid var(--_accent);
      background-color: color-mix(in lab, var(--_accent) 10%, var(--background));
      &.error {
        --_accent: #c53030;
      }
    }
    .contact-form_note-title {
      font-weight: var(--primary-bold);
    }
  }
</style>
