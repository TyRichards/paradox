---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/wrapper/Section.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import RichText from '@/components/typography/RichText.astro';
import Button from '@/components/Button.astro';
import ItemList from '@/components/content/ItemList.astro';
import { getOffers, getPage, offerContactHref } from '@/lib/content';

const page = await getPage('pricing');
const { Content } = await render(page);
const { title, description, heading, lede, audiences, closing } = page.data;
const offers = await getOffers();
---

<BaseLayout title={title} description={description}>
  {/* Header */}
  <Section paddingBottom="small">
    <Heading tag="h1" maxWidth={18}>{heading ?? title}</Heading>
    <Paragraph variant="large" class="color-faded" maxWidth={52}>{lede}</Paragraph>
  </Section>

  {/* Offers */}
  <Section paddingTop="none">
    <ItemList
      headingTag="h2"
      items={offers.map((offer) => ({
        id: offer.id,
        title: offer.data.title,
        meta: [offer.data.price, offer.data.cadence].filter(Boolean).join(' '),
        text: offer.data.summary,
        points: offer.data.bullets,
        action: { label: offer.data.ctaLabel, href: offerContactHref(offer.id), primary: offer.data.featured },
      }))}
    />
    {page.body?.trim() && <RichText maxWidth={60}><Content /></RichText>}
  </Section>

  {/* Audiences */}
  {audiences && (
    <Section paddingTop="none" paddingBottom="small" gap="5">
      <Heading variant="h4">{audiences.heading}</Heading>
      <div>
        {audiences.items.map((item) => (
          <Paragraph><strong>{item.title}.</strong> <span class="color-faded">{item.body}</span></Paragraph>
        ))}
      </div>
    </Section>
  )}

  {/* Closing */}
  {closing && (
    <Section paddingTop="none" gap="5">
      <Heading variant="h4">{closing.heading}</Heading>
      <Paragraph class="color-faded">{closing.text}</Paragraph>
      <Button element="link" href={closing.cta.href} variant="link">{closing.cta.label}</Button>
    </Section>
  )}
</BaseLayout>
