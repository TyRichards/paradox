---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/wrapper/Section.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import RichText from '@/components/typography/RichText.astro';
import OfferCards from '@/components/content/OfferCards.astro';
import { getOffers, getPage } from '@/lib/content';

const page = await getPage('pricing');
const { Content } = await render(page);
const { title, description, heading, lede } = page.data;
const offers = await getOffers();
---

<BaseLayout title={title} description={description}>
  {/* Header */}
  <Section paddingBottom="small">
    <Heading tag="h1" maxWidth={18}>{heading ?? title}</Heading>
    <Paragraph variant="large" class="color-faded" maxWidth={52}>{lede}</Paragraph>
  </Section>

  {/* Offers */}
  <Section paddingTop="none">
    <OfferCards offers={offers} />
    {page.body?.trim() && <RichText maxWidth={60}><Content /></RichText>}
  </Section>
</BaseLayout>
