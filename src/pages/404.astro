---
import ArrowLeft from '@tabler/icons/outline/arrow-left.svg';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { Button } from '@/components/starwind/button';
import { ui } from '@/lib/ui';
---

<BaseLayout title={ui.notFound.title} noindex>
  <PageHeader title={ui.notFound.title} lede={ui.notFound.lede}>
    <Button href="/" variant="primary" class="mt-8 rounded-full font-bold">
      <ArrowLeft />
      {ui.notFound.backLabel}
    </Button>
  </PageHeader>
</BaseLayout>
