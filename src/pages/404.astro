---
import ArrowLeft from '@tabler/icons/outline/arrow-left.svg';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { Button } from '@/components/starwind/button';
---

<BaseLayout title="Not found" noindex>
  <PageHeader title="That page wandered off." lede="It may have moved in the site rebuild.">
    <Button href="/" variant="primary" class="mt-8 rounded-full font-bold">
      <ArrowLeft /> Back home
    </Button>
  </PageHeader>
</BaseLayout>
