---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { formatDate, getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes and news from Paradox.">
  <PageHeader title="Blog" lede="Notes and news from Paradox." />
  <div class="mx-auto max-w-6xl px-6">
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet.</p>
      ) : (
        <ul class="max-w-3xl divide-y divide-line border-y border-line">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group block py-8">
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted">
                  {formatDate(post.data.pubDate)}
                </time>
                <h2 class="mt-1 text-2xl font-black tracking-tight group-hover:text-accent">
                  {post.data.title}
                  {post.data.draft && <span class="ml-2 align-middle text-xs font-bold text-accent uppercase">Draft</span>}
                  {post.data.placeholder && (
                    <span class="ml-2 rounded bg-highlight px-1.5 py-0.5 align-middle text-xs font-bold text-accent-ink uppercase">
                      Placeholder
                    </span>
                  )}
                </h2>
                {post.data.description && <p class="mt-2 text-muted">{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
