---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/wrapper/Section.astro';
import ButtonWrapper from '@/components/wrapper/ButtonWrapper.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import RichText from '@/components/typography/RichText.astro';
import Button from '@/components/Button.astro';
import { getPage } from '@/lib/content';

const home = await getPage('home');
const { Content } = await render(home);
const { heading, title, lede, ctas } = home.data;
const cta = ctas?.[0];
---

<BaseLayout description={home.data.description}>
  {/* Hero */}
  <Section paddingTop="large" paddingBottom="large" gap="6">
    <Heading tag="h1" maxWidth={18} class="text-wrap-balance">{heading ?? title}</Heading>
    <Paragraph variant="large" maxWidth={48} class="color-faded">{lede}</Paragraph>
    {home.body?.trim() && <RichText variant="large"><Content /></RichText>}
    {cta && (
      <ButtonWrapper marginTop="4">
        <Button element="link" href={cta.href}>{cta.label}</Button>
      </ButtonWrapper>
    )}
  </Section>
</BaseLayout>
