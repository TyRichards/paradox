---
import MarkdownPage from '@/components/MarkdownPage.astro';
import { Alert, AlertDescription, AlertTitle } from '@/components/starwind/alert';
import { Button } from '@/components/starwind/button';
import { Input, InputVariants } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { Spinner } from '@/components/starwind/spinner';
import { Textarea } from '@/components/starwind/textarea';
import { getOffers } from '@/lib/content';
import { ui } from '@/lib/ui';

// Cloudflare's always-pass test site key, used only by `astro dev` so the form works without real keys.
const DEV_TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? DEV_TEST_SITE_KEY : '');
const configured = Boolean(siteKey);

const t = ui.contact;
const offers = await getOffers();
const messages = {
  submit: t.submitLabel,
  sending: t.sendingLabel,
  tokenPending: t.tokenPending,
  errors: t.errors,
};
---

<MarkdownPage id="contact">
  {configured && <script slot="head" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <form
    id="contact-form"
    action="/api/contact"
    method="post"
    class="mt-10 max-w-xl space-y-6"
    novalidate
    data-configured={configured ? 'true' : 'false'}
    data-messages={JSON.stringify(messages)}
  >
    {
      !configured && (
        <Alert variant="warning">
          <AlertTitle>{t.notConfiguredTitle}</AlertTitle>
          <AlertDescription>{t.notConfiguredText}</AlertDescription>
        </Alert>
      )
    }

    <fieldset class="space-y-6" disabled={!configured}>
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="space-y-2">
          <Label for="contact-name">{t.nameLabel}</Label>
          <Input id="contact-name" name="name" autocomplete="name" required maxlength={200} />
        </div>
        <div class="space-y-2">
          <Label for="contact-email">{t.emailLabel}</Label>
          <Input id="contact-email" name="email" type="email" autocomplete="email" required maxlength={320} />
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="space-y-2">
          <Label for="contact-company">{t.companyLabel}</Label>
          <Input id="contact-company" name="company" autocomplete="organization" maxlength={200} />
        </div>
        <div class="space-y-2">
          <Label for="contact-offer">{t.offerLabel}</Label>
          <select id="contact-offer" name="offer" class={InputVariants.input({ class: 'pr-10' })}>
            {
              offers.map((offer) => (
                <option value={offer.id}>
                  {offer.data.title} ({offer.data.price})
                </option>
              ))
            }
            <option value="" selected>{t.offerOther}</option>
          </select>
        </div>
      </div>

      <div class="space-y-2">
        <Label for="contact-message">{t.messageLabel}</Label>
        <Textarea id="contact-message" name="message" rows={6} required maxlength={5000} placeholder={t.messagePlaceholder} />
      </div>

      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {configured && <div class="cf-turnstile" data-sitekey={siteKey} data-action="contact" data-theme="light" />}

      <div class="flex items-center gap-4">
        <Button type="submit" variant="primary" size="lg" class="rounded-full font-bold" data-submit>
          <Spinner class="hidden" data-spinner />
          <span data-label>{t.submitLabel}</span>
        </Button>
      </div>
    </fieldset>

    <div data-status aria-live="polite"></div>
  </form>

  <template id="contact-success">
    <Alert variant="success">
      <AlertTitle>{t.successTitle}</AlertTitle>
      <AlertDescription>{t.successText}</AlertDescription>
    </Alert>
  </template>
  <template id="contact-error">
    <Alert variant="error">
      <AlertTitle>{t.errorTitle}</AlertTitle>
      <AlertDescription data-message>{t.errorText}</AlertDescription>
    </Alert>
  </template>
</MarkdownPage>

<script>
  declare global {
    interface Window {
      turnstile?: { reset: (widget?: string | HTMLElement) => void };
    }
  }

  type Messages = { submit: string; sending: string; tokenPending: string; errors: Record<string, string> };

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const messages: Messages = JSON.parse(form?.dataset.messages ?? '{}');
  const params = new URLSearchParams(location.search);

  const offerSelect = form?.querySelector<HTMLSelectElement>('#contact-offer');
  const requestedOffer = params.get('offer');
  if (offerSelect && requestedOffer && [...offerSelect.options].some((o) => o.value === requestedOffer)) {
    offerSelect.value = requestedOffer;
  }

  function showStatus(kind: 'success' | 'error', message?: string) {
    const target = form?.querySelector<HTMLElement>('[data-status]');
    const template = document.querySelector<HTMLTemplateElement>(`#contact-${kind}`);
    if (!target || !template) return;
    const node = template.content.cloneNode(true) as DocumentFragment;
    const text = node.querySelector<HTMLElement>('[data-message]');
    if (message && text) text.textContent = message;
    target.replaceChildren(node);
  }

  const errorMessage = (code?: string | null) => (code ? messages.errors?.[code] : undefined);

  function setBusy(busy: boolean) {
    const button = form?.querySelector<HTMLButtonElement>('[data-submit]');
    if (!button) return;
    button.disabled = busy;
    button.querySelector('[data-spinner]')?.classList.toggle('hidden', !busy);
    const label = button.querySelector('[data-label]');
    if (label) label.textContent = busy ? messages.sending : messages.submit;
  }

  const status = params.get('status');
  if (status === 'sent') showStatus('success');
  if (status === 'error') showStatus('error', errorMessage(params.get('code')));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (form.dataset.configured !== 'true') return;
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (!data.get('cf-turnstile-response')) {
      showStatus('error', messages.tokenPending);
      return;
    }

    setBusy(true);
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new URLSearchParams(data as unknown as Record<string, string>),
      });
      const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (res.ok && body.ok) {
        const offer = offerSelect?.value;
        form.reset();
        if (offerSelect && offer !== undefined) offerSelect.value = offer;
        showStatus('success');
      } else {
        showStatus('error', errorMessage(body.error));
      }
    } catch {
      showStatus('error');
    } finally {
      setBusy(false);
      window.turnstile?.reset();
    }
  });
</script>
