---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { getWork } from '@/lib/content';
import { ui } from '@/lib/ui';

const work = await getWork();
---

<BaseLayout title={ui.work.title} description={ui.work.description}>
  <PageHeader title={ui.work.title} lede={ui.work.lede} />
  <div class="mx-auto max-w-6xl px-6">
    {work.length > 0 ? <WorkGrid entries={work} /> : <p class="text-muted-foreground">{ui.work.empty}</p>}
  </div>
</BaseLayout>
