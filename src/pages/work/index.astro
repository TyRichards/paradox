---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { getWork } from '../../lib/content';

const work = await getWork();
---

<BaseLayout title="Work" description="Brand, web, app, and print projects by Paradox.">
  <PageHeader
    title="Work"
    lede={`${work.length} projects carried over from the paradoxcreative.com portfolio. Full case studies and images arrive with the WordPress import.`}
  />
  <WorkGrid entries={work} />
</BaseLayout>
