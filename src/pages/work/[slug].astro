---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ArrowLeft from '@tabler/icons/outline/arrow-left.svg';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PlaceholderNote from '@/components/PlaceholderNote.astro';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { Separator } from '@/components/starwind/separator';
import { getWork, WORK_TYPE_LABELS } from '@/lib/content';

export const getStaticPaths = (async () => {
  const work = await getWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: work[i - 1], next: work[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, summary, types, client, projectDate, cover, coverAlt, gallery, placeholder } = entry.data;
const hasBody = Boolean(entry.body?.trim());

const hero = gallery.length > 0 ? gallery[0] : null;
const heroAlt = hero ? `${title} — project screenshot` : '';
const remainingGallery = gallery.length > 1 ? gallery.slice(1) : [];
---

<BaseLayout title={title} description={summary ?? `${title} — a Paradox project.`}>
  <PageHeader eyebrow="Work" title={title} lede={summary}>
    <dl class="mt-6 flex flex-wrap items-start gap-x-8 gap-y-3 text-sm">
      {
        types.length > 0 && (
          <div>
            <dt class="mb-1 font-bold">Type</dt>
            <dd class="flex flex-wrap gap-1.5">
              {types.map((t) => (
                <Badge href={`/work/type/${t}/`} variant="secondary" size="sm" eyebrow class="font-semibold">
                  {WORK_TYPE_LABELS[t]}
                </Badge>
              ))}
            </dd>
          </div>
        )
      }
      {
        client && (
          <div>
            <dt class="mb-1 font-bold">Client</dt>
            <dd class="text-muted-foreground">{client}</dd>
          </div>
        )
      }
      {
        projectDate && (
          <div>
            <dt class="mb-1 font-bold">Date</dt>
            <dd class="text-muted-foreground">{projectDate}</dd>
          </div>
        )
      }
    </dl>
  </PageHeader>

  <div class="mx-auto max-w-6xl px-6">
    {placeholder && <PlaceholderNote />}
    {
      hero ? (
        <img src={hero} alt={heroAlt} class="mb-10 w-full rounded-xl ring-1 ring-border" />
      ) : (
        cover && (
          <img
            src={cover}
            alt={coverAlt ?? ''}
            class="mx-auto mb-10 block max-w-full rounded-xl ring-1 ring-border"
            style="max-width: min(100%, 480px);"
          />
        )
      )
    }
    {
      hasBody && (
        <Prose class="text-lg">
          <Content />
        </Prose>
      )
    }
    {
      remainingGallery.length > 0 && (
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {remainingGallery.map((img) => (
            <img src={img} alt="" loading="lazy" class="w-full rounded-xl ring-1 ring-border" />
          ))}
        </div>
      )
    }

    <Separator class="mt-16 mb-6" />
    <nav aria-label="More work" class="flex justify-between gap-4">
      {
        prev ? (
          <Button href={`/work/${prev.id}/`} variant="ghost" class="font-semibold">
            <ArrowLeft />
            {prev.data.title}
          </Button>
        ) : (
          <span />
        )
      }
      {
        next && (
          <Button href={`/work/${next.id}/`} variant="ghost" class="font-semibold">
            {next.data.title}
            <ArrowRight />
          </Button>
        )
      }
    </nav>
  </div>
</BaseLayout>
