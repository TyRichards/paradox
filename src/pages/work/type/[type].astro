---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { getWork, WORK_TYPES, WORK_TYPE_LABELS, type WorkType } from '@/lib/content';

export const getStaticPaths = (() => WORK_TYPES.map((type) => ({ params: { type } }))) satisfies GetStaticPaths;

const type = Astro.params.type as WorkType;
const label = WORK_TYPE_LABELS[type];
const work = (await getWork()).filter((w) => w.data.types.includes(type));
---

<BaseLayout title={`${label} work`} description={`${label} projects by Paradox.`}>
  <PageHeader eyebrow="Work" title={label} lede={`${work.length} ${label.toLowerCase()} projects.`} />
  <WorkGrid entries={work} active={type} />
</BaseLayout>
